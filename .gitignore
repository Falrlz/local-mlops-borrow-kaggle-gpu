# kaggle-bridge: zips going to / coming from Kaggle (keep the empty folders)
kaggle-bridge/upload-to-kaggle/*
!kaggle-bridge/upload-to-kaggle/.gitkeep
kaggle-bridge/download-from-kaggle/*
!kaggle-bridge/download-from-kaggle/.gitkeep

# mlops-project: datasets (keep data/raw/ so users know where images go)
mlops-project/data/*
!mlops-project/data/raw/
mlops-project/data/raw/*
!mlops-project/data/raw/.gitkeep

# mlops-project: pipeline outputs (runs, MLflow)
mlops-project/outputs/
